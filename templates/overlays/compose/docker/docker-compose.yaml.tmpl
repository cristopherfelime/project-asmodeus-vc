name: "{{project_name}}"

services:
  postgres:
    image: postgres:16-alpine
    profiles: ["core"]
    restart: unless-stopped
    mem_limit: 512m
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-app}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-devpass}
      POSTGRES_DB: ${POSTGRES_DB:-{{package_name}}}
    ports:
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    volumes:
      - pg_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER:-app} -d $${POSTGRES_DB:-{{package_name}}}"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - {{project_name}}-net

  # Streaming profile: explicit split-listener configuration prevents the classic C1 bug
  # where containers receive `localhost:9092` as the advertised broker address and fail to reconnect.
  # - Container-to-container callers MUST connect to `broker:29092` (INTERNAL listener).
  # - Host-machine tools/CLI callers MUST connect to `localhost:9092` (EXTERNAL listener).
  broker:
    image: redpandadata/redpanda:v24.2.11
    profiles: ["streaming"]
    restart: unless-stopped
    mem_limit: 1024m
    command:
      - redpanda
      - start
      - --smp=1
      - --memory=512M
      - --overprovisioned
      - --kafka-addr=INTERNAL://0.0.0.0:29092,EXTERNAL://0.0.0.0:9092
      - --advertise-kafka-addr=INTERNAL://broker:29092,EXTERNAL://localhost:9092
      - --pandaproxy-addr=INTERNAL://0.0.0.0:28082,EXTERNAL://0.0.0.0:8082
      - --advertise-pandaproxy-addr=INTERNAL://broker:28082,EXTERNAL://localhost:8082
      - --rpc-addr=broker:33145
      - --advertise-rpc-addr=broker:33145
    ports:
      - "127.0.0.1:9092:9092"
      - "127.0.0.1:8082:8082"
    volumes:
      - redpanda_data:/var/lib/redpanda/data
    healthcheck:
      test: ["CMD-SHELL", "rpk cluster health | grep -q 'Healthy:.*true'"]
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
      - {{project_name}}-net

  minio:
    image: minio/minio:RELEASE.2024-11-07T00-52-20Z
    profiles: ["lakehouse"]
    restart: unless-stopped
    mem_limit: 512m
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-minioadmin}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-minioadmin}
    ports:
      - "127.0.0.1:9000:9000"
      - "127.0.0.1:9001:9001"
    volumes:
      - minio_data:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
      - {{project_name}}-net

  mlflow:
    image: ghcr.io/mlflow/mlflow:v2.18.0
    profiles: ["ml"]
    restart: unless-stopped
    mem_limit: 768m
    command: mlflow server --host 0.0.0.0 --port 5000 --backend-store-uri sqlite:///mlflow/mlflow.db --default-artifact-root /mlflow/artifacts
    ports:
      - "127.0.0.1:5000:5000"
    volumes:
      - mlflow_data:/mlflow
    networks:
      - {{project_name}}-net

networks:
  {{project_name}}-net:
    name: {{project_name}}-net

volumes:
  pg_data:
  redpanda_data:
  minio_data:
  mlflow_data:
