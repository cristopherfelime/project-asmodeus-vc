# ==============================================================================
# {{project_name}} — 4-Hop Environment Precedence Example
# ==============================================================================
# How values travel from your host to the running application (lowest -> highest):
#
#   Hop 1: Host .env file (developer convenience defaults on localhost)
#   Hop 2: `docker compose --env-file ...` interpolation inside docker-compose.yaml
#   Hop 3: Container `environment:` block in docker-compose.yaml (Docker DNS overrides)
#   Hop 4: Application startup `load_dotenv(override=False)` (NEVER clobbers Hop 3)
#
# Because Hop 4 uses `override=False`, a containerized service keeps `postgres` /
# `broker:29092` even if `.env` on disk still points at `localhost`.
# ==============================================================================

# --- Hop 1 / Local Host Defaults ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Core Profile (Postgres 16) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=devpass
POSTGRES_DB={{package_name}}
POSTGRES_PORT=5432
# Host-side DSN:
DATABASE_URL=postgresql://app:devpass@localhost:5432/{{package_name}}
# Hop 3 container-side override in Compose `environment:`:
# DATABASE_URL=postgresql://app:devpass@postgres:5432/{{package_name}}

# --- Streaming Profile (Redpanda C1 Split-Listener Safe) ---
# Host-side tools use EXTERNAL listener:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Hop 3 container-side override MUST use INTERNAL listener:
# KAFKA_BOOTSTRAP_SERVERS=broker:29092

# --- Lakehouse Profile (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
# Hop 3 container-side override:
# S3_ENDPOINT_URL=http://minio:9000
