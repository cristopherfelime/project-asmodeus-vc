package main

import (
	"context"
	"log/slog"
	"os"
	"os/signal"
	"syscall"

	"{{go_module}}/internal/adapters"
	"{{go_module}}/internal/domain"
)

func main() {
	logger := slog.New(slog.NewJSONHandler(os.Stdout, nil))
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	sink := adapters.NewInMemorySink()
	pool := adapters.NewWorkerPool(2, sink)

	jobs := []domain.Job{
		{
			ID:      "boot-1",
			Payload: "health-check",
		},
	}

	if err := pool.Run(ctx, jobs); err != nil {
		logger.Error("worker pool failed", slog.String("error", err.Error()))
		os.Exit(1)
	}

	logger.Info("service initialized",
		slog.String("service", "{{project_name}}"),
		slog.Int("processed", len(sink.Results())),
	)

	<-ctx.Done()
	logger.Info("shutdown signal received", slog.String("service", "{{project_name}}"))
}
