package adapters

import (
	"context"
	"sync"

	"{{go_module}}/internal/domain"
	"{{go_module}}/internal/ports"
)

// InMemorySink stores results in memory in a concurrency-safe slice.
type InMemorySink struct {
	mu      sync.Mutex
	results []domain.Result
}

// NewInMemorySink constructs an empty InMemorySink.
func NewInMemorySink() *InMemorySink {
	return &InMemorySink{}
}

// Write appends a processed result unless the context has been cancelled.
func (s *InMemorySink) Write(ctx context.Context, result domain.Result) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	s.results = append(s.results, result)
	return nil
}

// Results returns a snapshot copy of all recorded results.
func (s *InMemorySink) Results() []domain.Result {
	s.mu.Lock()
	defer s.mu.Unlock()
	out := make([]domain.Result, len(s.results))
	copy(out, s.results)
	return out
}

// WorkerPool processes jobs with a bounded number of concurrent goroutines.
type WorkerPool struct {
	workers int
	sink    ports.Sink
}

// NewWorkerPool constructs a WorkerPool clamped to at least one worker.
func NewWorkerPool(workers int, sink ports.Sink) *WorkerPool {
	if workers < 1 {
		workers = 1
	}
	return &WorkerPool{
		workers: workers,
		sink:    sink,
	}
}

// Run executes jobs across bounded workers and stops promptly on cancellation or error.
func (p *WorkerPool) Run(ctx context.Context, jobs []domain.Job) error {
	if err := ctx.Err(); err != nil {
		return err
	}

	ctx, cancel := context.WithCancel(ctx)
	defer cancel()

	jobCh := make(chan domain.Job)
	var (
		wg       sync.WaitGroup
		errOnce  sync.Once
		firstErr error
	)

	recordErr := func(err error) {
		if err != nil {
			errOnce.Do(func() {
				firstErr = err
				cancel()
			})
		}
	}

	for range p.workers {
		wg.Add(1)
		go func() {
			defer wg.Done()
			for job := range jobCh {
				if err := ctx.Err(); err != nil {
					recordErr(err)
					return
				}
				res, err := domain.Process(job)
				if err != nil {
					recordErr(err)
					return
				}
				if err := p.sink.Write(ctx, res); err != nil {
					recordErr(err)
					return
				}
			}
		}()
	}

dispatchLoop:
	for _, job := range jobs {
		select {
		case <-ctx.Done():
			recordErr(ctx.Err())
			break dispatchLoop
		case jobCh <- job:
		}
	}
	close(jobCh)

	wg.Wait()
	return firstErr
}
